/**
 * Fetches a clean 6-month historical line chart for global and SGX counters.
 * Fixes structural array missing errors found in LSE-listed ETFs like SPYL.
 *
 * @param {string} ticker The ticker from your sheet (e.g., "SGX:ES3", "SPYL.L").
 * @param {boolean} refresh_switch Points to your checkbox cell (e.g., $E$1) to force recalculation.
 * @customfunction
 */
function YAHOO_CHART(ticker, refresh_switch) {
  if (!ticker) return "";
  
  let cleanTicker = ticker.toString().toUpperCase().trim();
  if (cleanTicker.startsWith("SGX:")) {
    cleanTicker = cleanTicker.replace("SGX:", "");
    if (!cleanTicker.endsWith(".SI")) {
      cleanTicker = cleanTicker + ".SI";
    }
  }
  
  const options = {
    "muteHttpExceptions": true,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }
  };

  try {
    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${cleanTicker}?range=6mo&interval=1d`;
    const response = UrlFetchApp.fetch(url, options);
    const json = JSON.parse(response.getContentText());
    
    if (json.chart && json.chart.result && json.chart.result[0]) {
      const result = json.chart.result[0];
      let closingPrices = null;

      // Primary check for standard closing arrays (critical for LSE/EU ETFs like SPYL)
      if (result.indicators && result.indicators.quote && result.indicators.quote[0] && result.indicators.quote[0].close) {
        closingPrices = result.indicators.quote[0].close;
      } 
      // Fallback check for adjusted close arrays (common for SGX/US stocks)
      else if (result.indicators && result.indicators.adjclose && result.indicators.adjclose[0] && result.indicators.adjclose[0].adjclose) {
        closingPrices = result.indicators.adjclose[0].adjclose;
      }

      if (!closingPrices) return "No Data Array Found";

      const cleanPrices = closingPrices.filter(price => price !== null && price !== undefined && typeof price === 'number'); 
      if (cleanPrices.length === 0) return "No Data Available";

      const chartConfig = {
        type: 'line',
        data: {
          labels: Array(cleanPrices.length).fill(''), 
          datasets: [{
            data: cleanPrices,
            borderColor: '#0052cc', 
            borderWidth: 2,
            fill: false,
            pointRadius: 0 
          }]
        },
        options: {
          legend: { display: false },
          scales: { 
            xAxes: [{ display: false }], 
            yAxes: [{ display: false }] 
          }
        }
      };

      const encodedConfig = encodeURIComponent(JSON.stringify(chartConfig));
      return `https://quickchart.io/chart?c=${encodedConfig}&w=160&h=50`;
    }
    return "Chart Data Error";
  } catch (e) {
    return "Error Fetching Chart";
  }
}

/**
 * Fetches 365 days of historical closing prices for SGX and global counters.
 * Outputs a clean two-column array matching the standard GOOGLEFINANCE layout.
 *
 * @param {string} ticker The ticker from your sheet (e.g., "SGX:Z25", "NASDAQ:GRAB").
 * @customfunction
 */
function GLOBAL_HISTORICAL(ticker) {
  if (!ticker) return "";
  
  let cleanTicker = ticker.toString().toUpperCase().trim();
  
  // Handle explicit SGX prefixing matching your existing script design
  if (cleanTicker.startsWith("SGX:")) {
    cleanTicker = cleanTicker.replace("SGX:", "");
    if (!cleanTicker.endsWith(".SI")) {
      cleanTicker = cleanTicker + ".SI";
    }
  } else if (cleanTicker.includes(":")) {
    // If user inputs "NASDAQ:GRAB", drop the exchange part for Yahoo syntax
    cleanTicker = cleanTicker.split(":")[1];
  }

  const options = {
    "muteHttpExceptions": true,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }
  };

  // 365 days calculations using UNIX timestamps
  const endDate = Math.floor(Date.now() / 1000);
  const startDate = endDate - (365 * 24 * 60 * 60);

  try {
    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${cleanTicker}?period1=${startDate}&period2=${endDate}&interval=1d`;
    const response = UrlFetchApp.fetch(url, options);
    const json = JSON.parse(response.getContentText());
    
    if (json.chart && json.chart.result && json.chart.result[0]) {
      const result = json.chart.result[0];
      const timestamps = result.timestamp;
      let closingPrices = null;

      if (result.indicators && result.indicators.quote && result.indicators.quote[0] && result.indicators.quote[0].close) {
        closingPrices = result.indicators.quote[0].close;
      } else if (result.indicators && result.indicators.adjclose && result.indicators.adjclose[0] && result.indicators.adjclose[0].adjclose) {
        closingPrices = result.indicators.adjclose[0].adjclose;
      }

      if (!timestamps || !closingPrices) return "No Data Found";

      const output = [["Date", "Close"]];

      for (let i = 0; i < timestamps.length; i++) {
        let price = closingPrices[i];
        if (price !== null && price !== undefined) {
          let dateObj = new Date(timestamps[i] * 1000);
          output.push([dateObj, price]);
        }
      }
      
      return output;
    }
    return "Ticker Not Found";
  } catch (e) {
    return "Error Fetching Data";
  }
}
