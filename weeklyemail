const PORTFOLIO_CONFIG = {
  SHEET_NAME: 'Dashboard',
  RECIPIENT_EMAIL: '[YOUR_EMAIL_HERE]',
  GEMINI_MODEL: 'gemini-3.5-flash-lite',
  TIMEZONE: 'Asia/Singapore',
  SEND_HOUR_FRIDAY_SGT: 18,
  TAVILY_MAX_RESULTS: 5,
  TAVILY_SEARCH_DEPTH: 'basic',
  SNAPSHOT_PROPERTY_KEY: 'PORTFOLIO_LAST_SNAPSHOT'
};

const TAVILY_GROUPS = [
  {
    groupName: 'Singapore Blue Chips & REITs',
    query: '("Asset A" OR "Asset B" OR "Asset C" OR "Asset D") latest news OR earnings OR business update OR refinancing OR rates OR guidance past week Singapore SGX'
  },
  {
    groupName: 'Asian & China Market ETFs',
    query: '("ETF X" OR "ETF Y" OR "ETF Z" OR "ETF W") latest news OR China market OR Asia equities OR macro developments past week'
  },
  {
    groupName: 'Broad Market & Fixed Income ETFs',
    query: '("ETF P" OR "ETF Q" OR "ETF R") latest news OR market outlook OR index performance OR rates OR bond yields past week'
  }
];

function setPortfolioApiKeys() {
  const props = PropertiesService.getScriptProperties();
  props.setProperty('GEMINI_API_KEY', '[PASTE_GEMINI_KEY_HERE]');
  props.setProperty('TAVILY_API_KEY', '[PASTE_TAVILY_KEY_HERE]');
}

function createWeeklyPortfolioTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => {
    if (trigger.getHandlerFunction() === 'sendWeeklyPortfolioEmail') {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger('sendWeeklyPortfolioEmail')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.FRIDAY)
    .atHour(PORTFOLIO_CONFIG.SEND_HOUR_FRIDAY_SGT)
    .everyWeeks(1)
    .create();
}

function sendWeeklyPortfolioEmail() {
  if (!isFridayAfterClose_()) return;

  const currentHoldings = getDashboardHoldings();
  if (!currentHoldings.length) {
    throw new Error('No valid holdings found in Dashboard sheet.');
  }

  const previousSnapshot = getPreviousSnapshot_();
  const changeSummary = buildPortfolioChangeSummary_(currentHoldings, previousSnapshot);
  const groupedResearch = getGroupedTavilyResearch();
  const prompt = buildGeminiPortfolioPrompt(currentHoldings, previousSnapshot, changeSummary, groupedResearch);

  let htmlReport;
  try {
    htmlReport = callGeminiForHtmlReport(prompt);
  } catch (e) {
    htmlReport = buildFallbackHtmlReport(changeSummary, groupedResearch, e);
  }

  const dateLabel = Utilities.formatDate(new Date(), PORTFOLIO_CONFIG.TIMEZONE, 'yyyy-MM-dd');

  GmailApp.sendEmail(
    PORTFOLIO_CONFIG.RECIPIENT_EMAIL,
    `Weekly Portfolio Update - ${dateLabel}`,
    'HTML email required.',
    {
      htmlBody: htmlReport,
      name: 'Portfolio Report Bot'
    }
  );

  saveCurrentSnapshot_(currentHoldings);
}

