function isFridayAfterClose_() {
  const now = new Date();
  const day = Utilities.formatDate(now, PORTFOLIO_CONFIG.TIMEZONE, 'E');
  const hour = Number(Utilities.formatDate(now, PORTFOLIO_CONFIG.TIMEZONE, 'H'));
  return day === 'Fri' && hour >= PORTFOLIO_CONFIG.SEND_HOUR_FRIDAY_SGT;
}

function getDashboardHoldings() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PORTFOLIO_CONFIG.SHEET_NAME);
  if (!sheet) {
    throw new Error(`Sheet "${PORTFOLIO_CONFIG.SHEET_NAME}" not found.`);
  }

  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  const headers = values[0].map(h => String(h).trim());
  const rows = values.slice(1);

  const headerMap = {};
  headers.forEach((header, index) => {
    headerMap[header] = index;
  });

  const requiredHeaders = [
    'Ticker',
    'Asset Name',
    'P / L %',
    'Current Price',
    'NAV',
    'Quantity (Units)',
    'Avg Cost / W.A.C.',
    'Total Capital Invested',
    'Current Value',
    'P/ L',
    'Type'
  ];

  requiredHeaders.forEach(header => {
    if (!(header in headerMap)) {
      throw new Error(`Missing required header: "${header}"`);
    }
  });

  return rows
    .map(row => ({
      ticker: String(row[headerMap['Ticker']] || '').trim(),
      assetName: String(row[headerMap['Asset Name']] || '').trim(),
      profitLossPct: toNumber(row[headerMap['P / L %']]),
      currentPrice: toNumber(row[headerMap['Current Price']]),
      nav: toNumber(row[headerMap['NAV']]),
      quantity: toNumber(row[headerMap['Quantity (Units)']]),
      avgCost: toNumber(row[headerMap['Avg Cost / W.A.C.']]),
      totalInvested: toNumber(row[headerMap['Total Capital Invested']]),
      currentValue: toNumber(row[headerMap['Current Value']]),
      profitLoss: toNumber(row[headerMap['P/ L']]),
      type: String(row[headerMap['Type']] || '').trim()
    }))
    .filter(h => h.ticker && h.assetName && (h.quantity > 0 || h.currentValue > 0 || h.totalInvested > 0));
}

function getPreviousSnapshot_() {
  const raw = PropertiesService.getScriptProperties().getProperty(PORTFOLIO_CONFIG.SNAPSHOT_PROPERTY_KEY);
  if (!raw) return null;

  try {
    return JSON.parse(raw);
  } catch (e) {
    return null;
  }
}

function saveCurrentSnapshot_(holdings) {
  const snapshot = {
    savedAt: new Date().toISOString(),
    holdings: holdings
  };

  PropertiesService.getScriptProperties().setProperty(
    PORTFOLIO_CONFIG.SNAPSHOT_PROPERTY_KEY,
    JSON.stringify(snapshot)
  );
}

function buildPortfolioChangeSummary_(currentHoldings, previousSnapshot) {
  const previousHoldings = previousSnapshot && previousSnapshot.holdings ? previousSnapshot.holdings : [];
  const previousMap = {};
  previousHoldings.forEach(h => {
    previousMap[h.ticker] = h;
  });

  const currentMap = {};
  currentHoldings.forEach(h => {
    currentMap[h.ticker] = h;
  });

  const totalCurrentValue = currentHoldings.reduce((sum, h) => sum + Number(h.currentValue || 0), 0);

  const holdingChanges = currentHoldings.map(current => {
    const previous = previousMap[current.ticker];
    const previousPrice = previous ? Number(previous.currentPrice || 0) : 0;
    const currentPrice = Number(current.currentPrice || 0);
    const priceChange = previous ? (currentPrice - previousPrice) : currentPrice;
    const priceChangePct = previousPrice ? (priceChange / previousPrice) * 100 : null;

    return {
      ticker: current.ticker,
      assetName: current.assetName,
      type: current.type,
      previousPrice,
      currentPrice,
      priceChange,
      priceChangePct,
      previousQuantity: previous ? Number(previous.quantity || 0) : 0,
      currentQuantity: Number(current.quantity || 0),
      quantityChange: previous ? Number(current.quantity || 0) - Number(previous.quantity || 0) : Number(current.quantity || 0),
      currentValue: Number(current.currentValue || 0),
      allocationPct: totalCurrentValue ? (Number(current.currentValue || 0) / totalCurrentValue) * 100 : 0,
      isNew: !previous
    };
  });

  const removedHoldings = previousHoldings
    .filter(prev => !currentMap[prev.ticker])
    .map(prev => ({
      ticker: prev.ticker,
      assetName: prev.assetName,
      previousPrice: Number(prev.currentPrice || 0),
      previousQuantity: Number(prev.quantity || 0)
    }));

  const sortedByAbsMove = holdingChanges
    .slice()
    .sort((a, b) => Math.abs(b.priceChangePct || 0) - Math.abs(a.priceChangePct || 0));

  const finalAllocations = holdingChanges
    .slice()
    .sort((a, b) => b.allocationPct - a.allocationPct)
    .map(h => ({
      ticker: h.ticker,
      assetName: h.assetName,
      currentValue: h.currentValue,
      allocationPct: h.allocationPct
    }));

  return {
    hasPreviousSnapshot: !!previousSnapshot,
    previousSavedAt: previousSnapshot ? previousSnapshot.savedAt : null,
    upHoldings: holdingChanges.filter(h => h.priceChange > 0).length,
    downHoldings: holdingChanges.filter(h => h.priceChange < 0).length,
    flatHoldings: holdingChanges.filter(h => h.priceChange === 0).length,
    biggestPriceMoves: sortedByAbsMove.slice(0, 8),
    finalAllocations,
    holdingChanges,
    removedHoldings,
    totalCurrentValue
  };
}

function getGroupedTavilyResearch() {
  return TAVILY_GROUPS.map(group => runTavilyGroupSearch(group.groupName, group.query));
}

function runTavilyGroupSearch(groupName, query) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('TAVILY_API_KEY');
  if (!apiKey) {
    throw new Error('Missing TAVILY_API_KEY in Script Properties.');
  }

  const payload = {
    api_key: apiKey,
    query: query,
    topic: 'news',
    search_depth: PORTFOLIO_CONFIG.TAVILY_SEARCH_DEPTH,
    max_results: PORTFOLIO_CONFIG.TAVILY_MAX_RESULTS,
    include_answer: true,
    include_raw_content: false,
    time_range: 'w'
  };

  const options = {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch('https://api.tavily.com/search', options);
    const code = response.getResponseCode();
    const text = response.getContentText();

    if (code !== 200) {
      return {
        groupName,
        query,
        answer: '',
        results: [],
        error: text
      };
    }

    const json = JSON.parse(text);

    return {
      groupName,
      query,
      answer: json.answer || '',
      results: (json.results || []).map(item => ({
        title: item.title || '',
        url: item.url || '',
        content: item.content || '',
        score: item.score || null
      }))
    };
  } catch (e) {
    return {
      groupName,
      query,
      answer: '',
      results: [],
      error: String(e)
    };
  }
}

