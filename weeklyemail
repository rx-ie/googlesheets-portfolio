function callGeminiForHtmlReport(prompt) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  if (!apiKey) {
    throw new Error('Missing GEMINI_API_KEY in Script Properties.');
  }

  const url = `https://generativelanguage.googleapis.com/v1beta/models/${PORTFOLIO_CONFIG.GEMINI_MODEL}:generateContent?key=${apiKey}`;
  const payload = {
    contents: [{ parts: [{ text: prompt }] }],
    generationConfig: {
      temperature: 0.35,
      maxOutputTokens: 1200
    }
  };

  return fetchGeminiWithRetry_(url, payload, 3);
}

function fetchGeminiWithRetry_(url, payload, maxAttempts) {
  let lastError;

  for (let attempt = 1; attempt <= maxAttempts; attempt) {
    try {
      const options = {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(payload),
        muteHttpExceptions: true
      };

      const response = UrlFetchApp.fetch(url, options);
      const code = response.getResponseCode();
      const text = response.getContentText();

      if (code === 200) {
        const json = JSON.parse(text);
        const output = json?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!output) {
          throw new Error('Gemini returned no usable content.');
        }
        return output;
      }

      if (code === 429 || code >= 500) {
        lastError = new Error(`Gemini temporary error (${code}): ${text}`);
        Utilities.sleep(attempt * 2000);
        continue;
      }

      throw new Error(`Gemini API error (${code}): ${text}`);
    } catch (e) {
      lastError = e;
      if (attempt < maxAttempts) {
        Utilities.sleep(attempt * 2000);
      }
    }
  }

  throw lastError || new Error('Gemini request failed after retries.');
}

function buildFallbackHtmlReport(changeSummary, groupedResearch, errorObj) {
  const priceRows = (changeSummary.biggestPriceMoves || []).map(h => `
    <tr>
      <td>${escapeHtml_(h.ticker)}</td>
      <td>${escapeHtml_(h.assetName)}</td>
      <td>${formatNumber_(h.previousPrice)}</td>
      <td>${formatNumber_(h.currentPrice)}</td>
      <td>${formatSignedNumber_(h.priceChange)}</td>
      <td>${formatSignedPercent_(h.priceChangePct)}</td>
    </tr>
  `).join('');

  const allocationRows = (changeSummary.finalAllocations || []).map(h => `
    <tr>
      <td>${escapeHtml_(h.ticker)}</td>
      <td>${escapeHtml_(h.assetName)}</td>
      <td>${formatNumber_(h.currentValue)}</td>
      <td>${formatPercent_(h.allocationPct)}</td>
    </tr>
  `).join('');

  const researchHtml = groupedResearch.map(group => {
    const items = (group.results || []).slice(0, 3).map(r => `
      <li><strong>${escapeHtml_(r.title)}</strong><br>${escapeHtml_(r.content)}</li>
    `).join('');

    return `
      <h3>${escapeHtml_(group.groupName)}</h3>
      <p>${escapeHtml_(group.answer || 'No summary available.')}</p>
      <ul>${items || '<li>No relevant items returned.</li>'}</ul>
    `;
  }).join('');

  return `
    <h2>Weekly Portfolio Update</h2>
    <p><strong>Note:</strong> Gemini generation failed, so this fallback summary was sent.</p>
    <p><strong>Error:</strong> ${escapeHtml_(String(errorObj))}</p>

    <h3>What Moved in Price This Week</h3>
    <p><strong>Previous Snapshot:</strong> ${escapeHtml_(changeSummary.previousSavedAt || 'None')}</p>
    <p><strong>Holdings Up:</strong> ${changeSummary.upHoldings}</p>
    <p><strong>Holdings Down:</strong> ${changeSummary.downHoldings}</p>
    <p><strong>Holdings Flat:</strong> ${changeSummary.flatHoldings}</p>

    <table border="1" cellpadding="6" cellspacing="0">
      <tr>
        <th>Ticker</th>
        <th>Asset</th>
        <th>Prev Price</th>
        <th>Current Price</th>
        <th>Change</th>
        <th>Change %</th>
      </tr>
      ${priceRows}
    </table>

    <h3>Final Allocations</h3>
    <table border="1" cellpadding="6" cellspacing="0">
      <tr>
        <th>Ticker</th>
        <th>Asset</th>
        <th>Current Value</th>
        <th>Allocation %</th>
      </tr>
      ${allocationRows}
    </table>

    <h3>What to Pay Attention to Next</h3>
    ${researchHtml}

    <h3>Disclaimer</h3>
    <p>This automated summary is for informational purposes only and is not financial advice.</p>
  `;
}

function toNumber(value) {
  if (value === null || value === '' || value === undefined) return 0;
  if (typeof value === 'number') return value;
  const cleaned = String(value).replace(/[^0-9.-]/g, '');
  const num = parseFloat(cleaned);
  return isNaN(num) ? 0 : num;
}

function formatNumber_(value) {
  return Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 2 });
}

function formatPercent_(value) {
  return `${Number(value || 0).toFixed(2)}%`;
}

function formatSignedNumber_(value) {
  const num = Number(value || 0);
  const formatted = Math.abs(num).toLocaleString(undefined, { maximumFractionDigits: 2 });
  return num > 0 ? `+${formatted}` : num < 0 ? `-${formatted}` : '0';
}

function formatSignedPercent_(value) {
  if (value === null || value === undefined || isNaN(value)) return 'N/A';
  const num = Number(value || 0);
  return num > 0 ? `+${num.toFixed(2)}%` : num < 0 ? `${num.toFixed(2)}%` : '0.00%';
}

function escapeHtml_(text) {
  return String(text || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

